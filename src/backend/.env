# ============================================================
# BACKEND — Main API + Socket.io Service
# Port: 9000
# ============================================================

NODE_ENV=production

# Server
PORT=9000

# MongoDB — use service name 'mongo' inside Docker, localhost for dev
MONGO_URI=mongodb://mongo:27017/whatsappdb

# JWT — CHANGE THIS to a long random secret before deploying!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_here_64chars_minimum

# Frontend URL (for CORS — no trailing slash)
# In Docker: http://localhost  |  In production: https://yourdomain.com
FRONTEND_URL=http://localhost
