# ============================================================
# ROOT .env.example — Copy into each service and fill values
# DO NOT commit real .env files to Git!
# ============================================================

# ── BACKEND (port 9000) ──────────────────────────────────────
# Copy to: ./backend/.env
BACKEND_PORT=9000
BACKEND_MONGO_URI=mongodb://mongo:27017/whatsappdb
BACKEND_JWT_SECRET=CHANGE_ME_64char_random_string
BACKEND_FRONTEND_URL=http://localhost

# ── NEWSFEED (port 9001) ─────────────────────────────────────
# Copy to: ./newsfeed/.env
NEWSFEED_PORT=9001
NEWSFEED_MONGO_URI=mongodb://mongo:27017/whatsappdb

# ── STATUS (port 9002) ───────────────────────────────────────
# Copy to: ./status/.env
STATUS_PORT=9002
STATUS_MONGO_URI=mongodb://mongo:27017/whatsappdb

# ── REELS (port 9003) ────────────────────────────────────────
# Copy to: ./reels/.env
REELS_PORT=9003
REELS_MONGO_URI=mongodb://mongo:27017/whatsappdb

# ── FRONTEND (Vite build args) ───────────────────────────────
# Set in docker-compose.yaml under frontend.build.args:
VITE_API_URL=http://localhost:9000
VITE_NEWSFEED_API_URL=http://localhost:9001
VITE_STATUS_API_URL=http://localhost:9002
VITE_REELS_API_URL=http://localhost:9003
